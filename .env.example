# Chain (defaults are the verified Mezo testnet values)
NEXT_PUBLIC_MEZO_RPC_URL=https://rpc.test.mezo.org
# Set after deploying contracts/script/Deploy.s.sol — enables the automation panel
NEXT_PUBLIC_PROTECTOR_ADDRESS=0xA405907C5786bC93451A5F43FA9EdE379a80cB95
# Mezo Passport wallet modal. WalletConnect is listed only when a project id is set (cloud.reown.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database: Postgres in prod (Supabase/Neon). Locally: MEZOGUARD_DB=pglite (file DB at .data/pglite)
DATABASE_URL=
# Optional: put every MezoGuard table in this Postgres schema (for a database shared with other apps)
DB_SCHEMA=
MEZOGUARD_DB=pglite
PGLITE_DIR=.data/pglite

# Server secrets (never NEXT_PUBLIC_)
SESSION_SECRET=change-me-at-least-16-chars
CRON_SECRET=change-me
APP_URL=http://localhost:3000
MONITOR_INTERVAL_SECONDS=60

# Optional notification channels (missing → deliveries recorded as "skipped")
RESEND_API_KEY=
ALERT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
